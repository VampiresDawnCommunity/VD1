msgid ""
"\\>\\c[6]Linker Vampir-Fan:\\c[0]\n"
"Was glaubst du, welcher Vampir\n"
"ist der allerstärkste und beliebteste\n"
"Vampir der Welt??"
msgstr ""

msgid ""
"\\>\\c[7]Rechter Vampir-Fan:\\c[0]\n"
"Ich glaube, die meisten mögen Asgar\n"
"gerne, weil er so fette Sprüche reißt! \n"
