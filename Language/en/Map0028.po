"schwarzen Haaren und einem \n"
"fetten Schwert. Verdammt, ja! "
msgstr ""

msgid ""
"\\>\\c[9]Skeletthexenmeister:\\c[0]\n"
"Nu lenkter mich mal nich ab, nech?\\.\\.\n"
"Irgendjemand muss die ganzen\n"
"Weltkarten-Mobs ja vom Berg"
msgstr ""

