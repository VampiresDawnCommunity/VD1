msgid ""
"\\>\\c[3]Asgar:\\c[0]\n"
"Einen Moment noch. Ich habe dir das\n"
"hier noch nicht gegeben."
msgstr ""
"\\>\\c[3]Asgar:\\c[0]\n"
"One more thing. I still have something\n"
"to give to you."

msgid ""
"\\>\\c[2]Valnar:\\c[0]\n"
"Ich will FLIEHEN !\n"
"\\.\\.Dazu muss ich vom Schloss WEG !"
msgstr ""
"\\>\\c[2]Valnar:\\c[0]\n"
"I want to ESCAPE!\n"
"\\.\\.For that, I need to GET AWAY from the\n"
"castle!"

msgid ""
"\\>\\c[3]Asgar:\\c[0]\n"
"Ich möchte erst noch ausruhen !"
msgstr ""
"\\>\\c[3]Asgar:\\c[0]\n"
"I want to rest first!"

